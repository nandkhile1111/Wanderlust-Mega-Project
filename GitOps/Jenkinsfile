    //                 <p>Please check the Jenkins console output to identify the error.</p>
    //             </body>
    //             </html>
    //         """
    //     )
    // }

    failure {
        emailext(
            to: 'adityanandkhile9696@gmail.com',
            subject: "Wanderlust CI FAILED - Build #${env.BUILD_NUMBER}",
            body: """
                CI pipeline failed.

                Job: ${env.JOB_NAME}
                Build: #${env.BUILD_NUMBER}
                URL: ${env.BUILD_URL}console
            """
        )
    }

    always {
        echo "Wanderlust-CD finished with status: ${currentBuild.currentResult}"
    }
}

